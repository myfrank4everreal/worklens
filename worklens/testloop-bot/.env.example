# --- Required ---
# From @BotFather
BOT_TOKEN=YOUR_TOKEN_HERE
# Any long random string. Paste the same value into WorkLens → TestLoop → Connect bot.
SYNC_TOKEN=generate-a-long-random-string

# --- AI (OpenRouter: screenshot vision check + feedback scoring) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
VISION_MODEL=openai/gpt-4o
TEXT_MODEL=openai/gpt-4o-mini

# --- App ---
APP_NAME=Due soon
APP_SLUG=due-soon
DAYS_REQUIRED=14
# Play Console → Testing → Closed testing → "Join on web" link
PLAY_TEST_LINK=https://play.google.com/apps/testing/com.example.duesoon
# false = every verified tester waits for your approve click in WorkLens
AUTO_APPROVE=true

# --- Telegram groups (IDs look like -1001234567890) ---
MAIN_GROUP_ID=
MAIN_GROUP_INVITE=https://t.me/+yourInviteCode
LOGS_GROUP_ID=
# Your own Telegram user ID(s), comma separated; they can use /announce
ADMIN_IDS=

# --- WhatsApp Cloud API (optional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Comma separated numbers in international format without +, e.g. 2348012345678
WHATSAPP_RECIPIENTS=

# --- Hosting ---
# Railway sets PORT itself. DATA_DIR must be on a mounted volume or data is lost on redeploy.
DATA_DIR=/data
